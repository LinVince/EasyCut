{
  "name": "tw-stocks",
  "version": "2.0.0",
  "description": "Static PWA for tracking TW stocks — Yahoo Finance direct, IndexedDB favorites, offline-ready.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "deploy:worker": "wrangler deploy worker/index.js --name easycut-data-proxy --config worker/wrangler.toml"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "wrangler": "^4.131.0"
  }
}
